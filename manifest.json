{
  "manifest_version": 2,
  "name": "Hisaab Key",
  "version": "1.0.0",
  "description": "Unlocks CORS for local Tally XML server. The extension does not store or process any data. It simply adds CORS headers to the responses from the local Tally XML server.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "*://localhost:9000/*",
    "*://hisaab-website.pages.dev/*",
    "*://localhost/*"
  ],
  "browser_action": {
    "default_title": "Hisaab Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hisaab-dev-tools@hreemlabs.com",
      "strict_min_version": "58.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
